# ============================================================
# JeePay 国际支付 - 部署环境变量模板
# ------------------------------------------------------------
# 使用方法：cp .env.example .env  然后 vi .env 把所有 "请改为" 占位符替换为真实值
# 严禁把 .env 提交到 Git！本文件已在 .gitignore 中保护。
# ============================================================

# ============= 数据库（MySQL 8.0） =============
# 32 位强密码，包含大小写字母 + 数字 + 特殊符号
MYSQL_ROOT_PASSWORD=请改为强密码32位
MYSQL_DATABASE=jeepaydb
MYSQL_USER=jeepay
MYSQL_USER_PASSWORD=请改为强密码
MYSQL_PORT=3306

# ============= Redis 7 =============
REDIS_PASSWORD=请改为强密码
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# ============= RocketMQ 5.x =============
ROCKETMQ_NAMESRV_PORT=9876

# ============= JeePay 三大服务端口 =============
PAYMENT_PORT=9216
MANAGER_PORT=9217
MERCHANT_PORT=9218

# ============= 前端端口（nginx） =============
UI_MANAGER_PORT=8083
UI_MERCHANT_PORT=8082

# ============= JVM 调优（可不改） =============
PAYMENT_JAVA_OPTS=-XX:+UseG1GC -Xms512m -Xmx1g
MANAGER_JAVA_OPTS=-XX:+UseG1GC -Xms512m -Xmx1g
MERCHANT_JAVA_OPTS=-XX:+UseG1GC -Xms512m -Xmx1g

# ============= JWT 密钥（必改！强随机字符串 64 位） =============
# 生成示例：openssl rand -base64 48
JEEPAY_JWT_SECRET=请改为强随机字符串64位

# ============= Stripe 通道（先填测试 key，sk_test_ 开头） =============
STRIPE_API_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============= PayPal 通道（沙箱） =============
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ============= 汇率源（Fixer.io / apilayer） =============
FIXER_API_KEY=
FIXER_BASE_URL=https://api.apilayer.com/fixer
# Cron 表达式：默认每小时第 15 分钟刷新一次
RATE_REFRESH_CRON=0 15 * * * ?

# ============= 风控告警（Telegram） =============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RISK_ALERT_ENABLED=true

# ============= SMTP 邮件告警 =============
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ============= 风控总开关 =============
RISK_CONTROL_ENABLED=true
# 测试环境灰度比例：10 表示 10% 流量进入风控
RISK_GRAYSCALE=10

# ============= 调度开关（多副本时只允许一台为 true） =============
SCHEDULE_ENABLED=true

# ============= 后端服务可访问的公网地址（用于 webhook 回调与前端 API base） =============
# 测试环境无域名时直接填服务器公网 IP，例如：http://1.2.3.4
PUBLIC_BASE_URL=http://请填写服务器IP或域名

# ============= CORS 跨域白名单（安全加固 S3/S4，必改！） =============
# 为什么必改：默认 manager / merchant / payment 三端都会拒绝白名单外的跨域请求。
#            若部署后前端报 "CORS blocked"，把前端实际访问的 origin 加进来即可。
# 格式说明：逗号分隔，可包含端口；支持模式串如 http://localhost:* （仅本地调试用）
# 单域名示例（推荐生产）：JEEPAY_CORS_ORIGINS=https://pay.example.com
# 多域名示例：JEEPAY_CORS_ORIGINS=https://admin.example.com,https://mch.example.com,https://pay.example.com
# 仅服务器 IP 部署（测试期）：JEEPAY_CORS_ORIGINS=http://1.2.3.4:8083,http://1.2.3.4:8082
# 生产严禁配 "*" 或 http://*，否则等同于关闭 CORS 防护
JEEPAY_CORS_ORIGINS=http://localhost,http://localhost:8083,http://localhost:8082
